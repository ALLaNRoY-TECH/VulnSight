# Copy to .env (or export) to override defaults
VULNSIGHT_ALLOW_PRIVATE=0        # 1 = allow scanning private/loopback IPs (local labs only)
VULNSIGHT_RATE_LIMIT=6           # scans per client IP per minute
VULNSIGHT_DB=./vulnsight.db      # SQLite file for scan history
VULNSIGHT_HTTP_TIMEOUT=8         # seconds
VULNSIGHT_CORS=http://localhost:5173
